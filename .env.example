# Copy these values into your deployment environment; do not commit a real .env file.
LOCATIONIQ_TOKEN=replace-with-locationiq-token
MONGODB_URI=mongodb://localhost:27017/locationdb
MONGODB_DATABASE=locationdb
CORS_ALLOWED_ORIGIN_PATTERNS=https://bestue.netlify.app,http://localhost:5173
STORE_LOCATIONS=true

# Optional legacy stored-session image storage.
# The recommended direct Gemini endpoint does not require these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini is called by the backend only
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional tuning
PHOTO_MAX_UPLOAD_SIZE=10MB
PHOTO_MAX_REQUEST_SIZE=11MB
PHOTO_MAX_IMAGE_BYTES=10485760
PHOTO_MAX_IMAGE_DIMENSION=12000
PHOTO_MAX_LOCATION_ACCURACY=100000
GEMINI_CONNECT_TIMEOUT_MS=5000
GEMINI_READ_TIMEOUT_MS=120000
CLOUDINARY_CONNECT_TIMEOUT_MS=5000
CLOUDINARY_READ_TIMEOUT_MS=45000
PHOTO_PROCESSING_CORE_POOL_SIZE=2
PHOTO_PROCESSING_MAX_POOL_SIZE=4
PHOTO_PROCESSING_QUEUE_CAPACITY=20
